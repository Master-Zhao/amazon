{
  "name": "amazon-ads-optimizer-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm typecheck && vite build",
    "generate:api": "openapi-typescript ../openapi/schema.yaml -o src/shared/api/generated/schema.d.ts"
  },
  "dependencies": {
    "axios": ">=1.8 <2",
    "echarts": "6.0.0",
    "pinia": ">=3 <4",
    "vue": ">=3.5 <4",
    "vue-router": ">=4.5 <5"
  },
  "devDependencies": {
    "@eslint/js": ">=9 <10",
    "@types/node": ">=24 <25",
    "@vitejs/plugin-vue": ">=6 <7",
    "@vue/test-utils": ">=2.4 <3",
    "eslint": ">=9 <10",
    "eslint-plugin-vue": ">=10 <11",
    "jsdom": ">=27 <28",
    "openapi-typescript": ">=7 <8",
    "typescript": ">=5.9 <6",
    "typescript-eslint": ">=8 <9",
    "vite": ">=8 <9",
    "vitest": ">=4 <5",
    "vue-tsc": ">=3 <4"
  },
  "packageManager": "pnpm@11.9.0"
}
