# Copy to .env for local use. All values below are non-production placeholders.
COMPOSE_PROJECT_NAME=amazon-ads-v1

APP_VERSION=0.1.0
GIT_COMMIT=development
BUILD_TIME=not-set

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
DJANGO_DEBUG=true
LOG_LEVEL=INFO
ACTION_EVIDENCE_MAX_BYTES=10485760

DB_NAME=amazon_ads
DB_USER=amazon_ads
DB_PASSWORD=replace-with-app-database-password
DB_HOST=mysql
DB_PORT=3306
DB_CONN_MAX_AGE=60
MYSQL_ROOT_PASSWORD=replace-with-root-database-password

# Optional read-only remote advertising data sources. Use database accounts
# that have SELECT permission only. Map each project Profile to an exact
# remote mer_id + mer_code pair.
REMOTE_AD_DATABASES_ENABLED=false
SCM_REMOTE_DB_NAME=replace-with-scm-database-name
SCM_REMOTE_DB_USER=replace-with-read-only-user
SCM_REMOTE_DB_PASSWORD=replace-with-read-only-password
SCM_REMOTE_DB_HOST=replace-with-scm-host
SCM_REMOTE_DB_PORT=3306
ADS_ANALYSIS_REMOTE_DB_NAME=replace-with-analysis-database-name
ADS_ANALYSIS_REMOTE_DB_USER=replace-with-read-only-user
ADS_ANALYSIS_REMOTE_DB_PASSWORD=replace-with-read-only-password
ADS_ANALYSIS_REMOTE_DB_HOST=replace-with-analysis-host
ADS_ANALYSIS_REMOTE_DB_PORT=3306
REMOTE_AD_PROFILE_MERCHANT_MAP={"DEMO-PROFILE-US-001":{"merchantId":1,"merchantCode":"W0092"}}
REMOTE_AD_MAX_ROWS=200

REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/2
CACHE_KEY_PREFIX=amazon-ads-v1
CACHE_DEFAULT_TIMEOUT=300
API_ANON_RATE=60/min
API_TENANT_USER_RATE=600/min
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_TIME_LIMIT=30
CELERY_TASK_SOFT_TIME_LIMIT=20
CELERY_RESULT_EXPIRES=3600

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=false

# Phase 2A JWT authentication. Refresh tokens are only transported in HttpOnly cookies.
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_PATH=/api/v1/auth/
JWT_COOKIE_SECURE=false
JWT_COOKIE_HTTP_ONLY=true
JWT_COOKIE_SAME_SITE=Lax
JWT_ROTATE_REFRESH_TOKENS=true
JWT_BLACKLIST_AFTER_ROTATION=true
DEMO_USER_EMAIL=demo@example.invalid
# Set DEMO_USER_PASSWORD only in your local shell or untracked .env; never commit it.

VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://backend:8000
VITE_APP_VERSION=0.1.0
VITE_GIT_COMMIT=development
VITE_BUILD_TIME=not-set
