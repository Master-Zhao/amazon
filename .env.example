# Safe offline defaults. Copy to .env only on your own machine.
LLM_PROVIDER=stub
LLM_REAL_CALL_ENABLED=false
LLM_MODEL=<model-name>
LLM_API_KEY=<set-locally>
LLM_BASE_URL=<provider-base-url>
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=1024

REAL_EVALUATION_MAX_REQUESTS=60
REAL_EVALUATION_MAX_AGENT_REVISIONS=3
REAL_EVALUATION_MAX_TRANSPORT_RETRIES=1
REAL_EVALUATION_REPETITIONS=3
