{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/amazon-ads-agent-poc/agent-output.schema.json",
  "title": "PoC Agent Output",
  "description": "Deterministically post-processed keyword bid plan or bounded terminal result.",
  "x-schema-version": "2.0-poc.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "run_id", "attempt_id", "current_status",
    "completion_reason", "analysis_summary", "issues", "plan_version",
    "rule_set_version", "data_snapshot_id", "plan_digest", "changes",
    "calculated_risk_level", "runtime_validation", "execution_preflight",
    "retry_count", "human_approval_required", "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "task_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "current_status": {"enum": ["validating_plan", "waiting_for_approval", "completed", "manual_intervention_required"]},
    "completion_reason": {"enum": ["no_change_required", "insufficient_evidence", null]},
    "analysis_summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_id", "type", "evidence_paths"],
        "properties": {
          "issue_id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "evidence_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "plan_version": {"type": "integer", "minimum": 0, "maximum": 4},
    "rule_set_version": {"type": "string", "minLength": 1},
    "data_snapshot_id": {"type": "string", "minLength": 1},
    "plan_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "changes": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/change"}},
    "calculated_risk_level": {"enum": ["low", "medium", "high"]},
    "runtime_validation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "error_code", "failed_rule_ids"],
          "properties": {
            "passed": {"type": "boolean"},
            "error_code": {"type": ["string", "null"], "pattern": "^ERR_[A-Z0-9_]+$"},
            "failed_rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    },
    "execution_preflight": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "preflight_id", "mode", "request_digest", "production_write_called"],
          "properties": {
            "passed": {"type": "boolean"},
            "preflight_id": {"type": ["string", "null"]},
            "mode": {"const": "dry_run"},
            "request_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
            "production_write_called": {"const": false}
          }
        }
      ]
    },
    "retry_count": {"type": "integer", "minimum": 0, "maximum": 3},
    "human_approval_required": {"type": "boolean"},
    "generated_at": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id", "object_type", "object_id", "action", "expected_current_value",
        "expected_object_version", "candidate_values", "suggested_value", "change_ratio",
        "reason", "evidence", "confidence", "change_risk_level"
      ],
      "properties": {
        "change_id": {"type": "string", "minLength": 1},
        "object_type": {"const": "keyword"},
        "object_id": {"type": "string", "minLength": 1},
        "action": {"const": "update_bid"},
        "expected_current_value": {"$ref": "#/$defs/decimal"},
        "expected_object_version": {"type": "string", "minLength": 1},
        "candidate_values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/decimal"}},
        "suggested_value": {"$ref": "#/$defs/decimal"},
        "change_ratio": {"$ref": "#/$defs/decimal"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "value"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "value": {"type": ["string", "integer", "null"]}
            }
          }
        },
        "confidence": {"type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"},
        "change_risk_level": {"enum": ["low", "medium", "high"]}
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "current_status": {"const": "completed"},
        "completion_reason": {"enum": ["no_change_required", "insufficient_evidence"]},
        "plan_version": {"const": 0},
        "plan_digest": {"type": "null"},
        "changes": {"maxItems": 0},
        "runtime_validation": {"type": "null"},
        "execution_preflight": {"type": "null"},
        "human_approval_required": {"const": false}
      }
    },
    {
      "properties": {
        "current_status": {"const": "validating_plan"},
        "completion_reason": {"type": "null"},
        "plan_version": {"minimum": 1},
        "plan_digest": {"type": "string"},
        "changes": {"minItems": 1},
        "runtime_validation": {"type": "null"},
        "execution_preflight": {"type": "null"},
        "human_approval_required": {"const": true}
      }
    },
    {
      "properties": {
        "current_status": {"const": "waiting_for_approval"},
        "completion_reason": {"type": "null"},
        "plan_version": {"minimum": 1},
        "plan_digest": {"type": "string"},
        "changes": {"minItems": 1},
        "runtime_validation": {"type": "object", "properties": {"passed": {"const": true}, "error_code": {"type": "null"}}},
        "execution_preflight": {"type": "object", "properties": {"passed": {"const": true}, "production_write_called": {"const": false}}},
        "human_approval_required": {"const": true}
      }
    },
    {
      "properties": {
        "current_status": {"const": "manual_intervention_required"},
        "completion_reason": {"type": "null"},
        "plan_version": {"minimum": 1},
        "plan_digest": {"type": "null"},
        "changes": {"maxItems": 0},
        "runtime_validation": {"type": "object", "properties": {"passed": {"const": false}, "error_code": {"type": "string"}}},
        "execution_preflight": {"type": "object", "properties": {"passed": {"const": false}, "production_write_called": {"const": false}}},
        "human_approval_required": {"const": false}
      }
    }
  ]
}
