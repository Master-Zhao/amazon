{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/amazon-ads-agent-poc/failure-analysis.schema.json",
  "title": "PoC Failure Analysis",
  "description": "Machine-readable failure decision for bounded pre-approval revision.",
  "x-schema-version": "2.0-poc.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "run_id", "attempt_id", "plan_version",
    "error_code", "error_fingerprint", "error_category", "error_message",
    "failed_rule_ids", "correctable", "retry_allowed", "retry_count",
    "same_error_consecutive_count", "next_action", "analyzed_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "task_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "plan_version": {"type": "integer", "minimum": 1, "maximum": 4},
    "error_code": {"type": "string", "pattern": "^ERR_[A-Z0-9_]+$"},
    "error_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "error_category": {"enum": ["schema", "data", "rule", "security", "internal"]},
    "error_message": {"type": "string", "minLength": 1, "maxLength": 1000},
    "failed_rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "correctable": {"type": "boolean"},
    "retry_allowed": {"type": "boolean"},
    "retry_count": {"type": "integer", "minimum": 0, "maximum": 3},
    "same_error_consecutive_count": {"type": "integer", "minimum": 1},
    "next_action": {"enum": ["revise_plan", "manual_intervention_required"]},
    "analyzed_at": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}
  },
  "allOf": [
    {
      "if": {"properties": {"retry_allowed": {"const": true}}},
      "then": {"properties": {"correctable": {"const": true}, "next_action": {"const": "revise_plan"}}},
      "else": {"properties": {"next_action": {"const": "manual_intervention_required"}}}
    }
  ]
}
