{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/amazon-ads-agent-poc/reasoner-output.schema.json",
  "title": "Reasoner Structured Output",
  "description": "Untrusted model selection and explanation; business validity remains with Runtime Validator.",
  "x-schema-version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "selected_value",
    "reason",
    "evidence_paths",
    "risk_summary",
    "confidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "decision": {"const": "select"},
    "selected_value": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 40
    },
    "reason": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "evidence_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"}
    },
    "risk_summary": {
      "type": "string",
      "minLength": 5,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "confidence": {
      "type": "string",
      "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$",
      "maxLength": 20
    }
  }
}
